{
  "name": "moeshare",
  "version": "3.2.0",
  "description": "Selbst gehosteter ShareX-Uploader für Dateien, Texte und Kurzlinks, mit Weboberfläche, Alben, Embed Builder und Benutzerverwaltung.",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node index.js",
    "build": "npm --prefix client ci --no-audit --no-fund && npm --prefix client run build",
    "dev:ui": "npm --prefix client run dev",
    "typecheck": "npm --prefix client run typecheck",
    "register": "node cli.js register",
    "token": "node cli.js token",
    "reset": "node cli.js reset"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mime-types": "^3.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "sqlite3": "^6.0.1",
    "tar": "^7.5.22",
    "uqr": "^0.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximilianGT500/moeshare.git"
  },
  "keywords": [
    "moeshare",
    "sharex",
    "uploader",
    "upload",
    "files",
    "selfhosted",
    "nodejs",
    "express",
    "sqlite",
    "docker",
    "postgresql",
    "mysql",
    "mariadb",
    "pastebin",
    "url-shortener",
    "s3"
  ],
  "author": "MaximilianGT500",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MaximilianGT500/moeshare/issues"
  },
  "homepage": "https://moeshare.eu",
  "allowScripts": {
    "bcrypt": true,
    "sqlite3": true
  }
}
