{
  "name": "moeshare",
  "version": "3.0.0",
  "description": "Selbst gehosteter ShareX-Uploader mit Weboberfläche, Startseite, Embed Builder und Benutzerverwaltung.",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "build": "npm --prefix client ci --no-audit --no-fund && npm --prefix client run build",
    "dev:ui": "npm --prefix client run dev",
    "typecheck": "npm --prefix client run typecheck",
    "register": "node cli.js register",
    "token": "node cli.js token",
    "reset": "node cli.js reset"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@qoocollections/content-metadata-remover": "^1.1.1",
    "@simplewebauthn/server": "^14.0.3",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "sqlite3": "^5.1.7",
    "uqr": "^0.1.3"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/win32-x64": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaximilianGT500/moeshare.git"
  },
  "keywords": [
    "moeshare",
    "sharex",
    "uploader",
    "upload",
    "files",
    "selfhosted",
    "nodejs",
    "express",
    "sqlite",
    "docker"
  ],
  "author": "MaximilianGT500",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MaximilianGT500/moeshare/issues"
  },
  "homepage": "https://moeshare.eu"
}
